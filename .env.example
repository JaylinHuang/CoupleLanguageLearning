DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Session secret — change to a long random string in production
SESSION_SECRET="change-me-to-a-long-random-string-in-production"

# Default passwords (used on first seed only; change after login)
ERIKA_PASSWORD="your-erika-password"
LIN_PASSWORD="your-lin-password"

# DeepSeek API
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_CHAT_MODEL="deepseek-chat"

# OpenAI Embeddings (for RAG — hash fallback if unset)
OPENAI_API_KEY="your-openai-api-key"
OPENAI_BASE_URL="https://api.openai.com/v1"
EMBEDDING_MODEL="text-embedding-3-small"

# RAG tuning
RAG_TOP_K="8"
RAG_RERANK_TOP_K="4"
MAX_CONTEXT_TOKENS="3000"
MAX_HISTORY_MESSAGES="20"

# AI Microservice (optional — unset to run AI in-process)
# AI_SERVICE_URL="http://localhost:3001"
# AI_SERVICE_API_KEY="change-me-to-a-long-random-key"

# Email notifications (QQ mail SMTP example)
SMTP_HOST="smtp.qq.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-qq-email@qq.com"
SMTP_PASS="your-qq-smtp-authorization-code"
NOTIFY_EMAIL="2810745803@qq.com"

# Optional: protect Vercel Cron endpoints (Authorization: Bearer …)
# CRON_SECRET="change-me-to-a-long-random-string"

# Optional: Vercel Blob for homework audio (otherwise stored inline)
# BLOB_READ_WRITE_TOKEN=""

# Site branding
NEXT_PUBLIC_SITE_NAME="Jaylin_love_Erika"
