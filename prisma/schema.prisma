generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// platformRole: MEMBER | PLATFORM_ADMIN
// role（遗留）: LEARNER | ADMIN — 过渡期与 CoupleMembership 并存
model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String?   @unique
  emailVerified DateTime?
  passwordHash  String
  displayName   String
  role          String
  platformRole  String    @default("MEMBER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  progress            UserProgress?
  lessonProgress      LessonProgress[]
  lessonAttempts      LessonAttempt[]
  reviewCards         ReviewCard[]
  wishes              WishItem[]
  homeworkAssigned    Homework[]           @relation("HomeworkAssigner")
  homeworkAssignedTo  Homework[]           @relation("HomeworkAssignee")
  homeworkSubmissions HomeworkSubmission[]
  notifications       Notification[]
  achievements        Achievement[]
  grammarCorrections  GrammarCorrection[]
  memberships         CoupleMembership[]
  ownedCourses        Course[]             @relation("CourseOwner")
  corpusImports       CorpusImport[]
  emailTokens         EmailVerificationToken[]
}

model UserProgress {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hskLevel      Int       @default(1)
  xp            Int       @default(0)
  level         Int       @default(1)
  streak        Int       @default(0)
  longestStreak Int       @default(0)
  lastStudyDate DateTime?
  updatedAt     DateTime  @updatedAt
}

model Couple {
  id              String   @id @default(cuid())
  slug            String   @unique
  displayName     String
  status          String   @default("PENDING_VERIFY") // PENDING_VERIFY | ACTIVE | PAUSED | DISSOLVED
  personaPrompt   String?
  learnerNickname String?
  tutorNickname   String?
  siteTitle       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships  CoupleMembership[]
  enrollments  Enrollment[]
  privateCourses Course[]         @relation("CouplePrivateCourses")
  personCards  PersonCard[]
  wishes       WishItem[]
  homeworks    Homework[]
  learningItems LearningItem[]
  knowledgeChunks KnowledgeChunk[]
  corpusImports CorpusImport[]
  chatSessions ChatSession[]
}

model CoupleMembership {
  id       String   @id @default(cuid())
  coupleId String
  userId   String   @unique
  role     String // TUTOR | LEARNER
  createdAt DateTime @default(now())
  couple   Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([coupleId, role])
  @@index([coupleId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subject {
  id              String @id
  name            String
  practiceModules String @default("[]") // JSON string[]

  courses       Course[]
  learningItems LearningItem[]
  knowledgeChunks KnowledgeChunk[]
  corpusImports CorpusImport[]
}

model Course {
  id                   String   @id @default(cuid())
  subjectId            String
  title                String
  description          String?
  visibility           String   @default("SHARED_TEMPLATE") // SHARED_TEMPLATE | COUPLE_PRIVATE
  ownerCoupleId        String?
  ownerUserId          String?
  templateId           String?  @unique
  templateVersion      Int      @default(1)
  forkedFromTemplateId String?
  forkedFromVersion    Int?
  published            Boolean  @default(true)
  order                Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subject     Subject      @relation(fields: [subjectId], references: [id])
  ownerCouple Couple?      @relation("CouplePrivateCourses", fields: [ownerCoupleId], references: [id], onDelete: SetNull)
  ownerUser   User?        @relation("CourseOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  lessons     Lesson[]
  enrollments Enrollment[]

  @@index([subjectId])
  @@index([ownerCoupleId])
  @@index([visibility])
}

model Enrollment {
  id         String   @id @default(cuid())
  coupleId   String
  courseId   String
  status     String   @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED
  levelLabel String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  couple     Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([coupleId, courseId])
  @@index([coupleId])
}

// 遗留词表：过渡期保留；新逻辑优先 LearningItem
model Word {
  id           String   @id @default(cuid())
  simplified   String
  traditional  String?
  pinyin       String
  pinyinNumber String
  english      String
  tagalogShort String?
  hskLevel     Int      @default(1)
  audioUrl     String?
  isCustom     Boolean  @default(false)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lessonWords LessonWord[]
  reviewCards ReviewCard[]
}

model LearningItem {
  id               String   @id @default(cuid())
  subjectId        String
  itemType         String // chinese_word | generic
  title            String
  meaningPrimary   String
  meaningSecondary String?
  tags             String   @default("[]")
  audioUrl         String?
  notes            String?
  scope            String   @default("SHARED") // SHARED | COUPLE
  ownerCoupleId    String?
  sourceRef        String? // 如 word:<id>
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subject      Subject               @relation(fields: [subjectId], references: [id])
  ownerCouple  Couple?               @relation(fields: [ownerCoupleId], references: [id], onDelete: Cascade)
  chineseExt   ChineseWordExtension?
  reviewCards  ReviewCard[]
  lessonItems  LessonLearningItem[]

  @@index([subjectId, scope])
  @@index([ownerCoupleId])
  @@index([sourceRef])
}

model ChineseWordExtension {
  learningItemId String @id
  simplified     String
  traditional    String?
  pinyin         String
  pinyinNumber   String
  hskLevel       Int    @default(1)
  learningItem   LearningItem @relation(fields: [learningItemId], references: [id], onDelete: Cascade)

  @@index([hskLevel])
  @@index([simplified])
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String?
  title       String
  description String?
  hskLevel    Int      @default(1)
  levelLabel  String?
  sceneTag    String?
  order       Int      @default(0)
  content     String
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course   Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  words    LessonWord[]
  items    LessonLearningItem[]
  progress LessonProgress[]
  attempts LessonAttempt[]

  @@index([courseId])
}

model LessonWord {
  id       String @id @default(cuid())
  lessonId String
  wordId   String
  order    Int    @default(0)
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  word     Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([lessonId, wordId])
}

model LessonLearningItem {
  id             String @id @default(cuid())
  lessonId       String
  learningItemId String
  order          Int    @default(0)
  lesson         Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  learningItem   LearningItem @relation(fields: [learningItemId], references: [id], onDelete: Cascade)

  @@unique([lessonId, learningItemId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  status      String    @default("NOT_STARTED")
  score       Int?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model LessonAttempt {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  score       Int
  answers     String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
  @@index([completedAt])
}

model ReviewCard {
  id             String    @id @default(cuid())
  userId         String
  wordId         String?
  learningItemId String?
  ease           Float     @default(2.5)
  interval       Int       @default(0)
  repetitions    Int       @default(0)
  dueDate        DateTime  @default(now())
  markedHard     Boolean   @default(false)
  lastReview     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  word           Word?     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  learningItem   LearningItem? @relation(fields: [learningItemId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@unique([userId, learningItemId])
  @@index([learningItemId])
}

model PersonCard {
  id        String   @id @default(cuid())
  coupleId  String?
  name      String
  relation  String
  avatarUrl String?
  phrases   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  couple    Couple?  @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@index([coupleId])
}

model WishItem {
  id        String   @id @default(cuid())
  userId    String
  coupleId  String?
  text      String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  couple    Couple?  @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@index([coupleId])
}

model Homework {
  id           String    @id @default(cuid())
  coupleId     String?
  assignedById String
  assigneeId   String?
  courseId     String?
  title        String
  description  String?
  audioPath    String?
  payload      String
  dueDate      DateTime?
  status       String    @default("ASSIGNED")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  couple       Couple?   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  assignedBy   User      @relation("HomeworkAssigner", fields: [assignedById], references: [id], onDelete: Cascade)
  assignee     User?     @relation("HomeworkAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  submissions  HomeworkSubmission[]

  @@index([coupleId])
}

model HomeworkSubmission {
  id          String   @id @default(cuid())
  homeworkId  String
  userId      String
  textAnswer  String?
  audioPath   String?
  submittedAt DateTime @default(now())
  feedback    String?
  reviewedAt  DateTime?
  homework    Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GrammarCorrection {
  id        String   @id @default(cuid())
  userId    String
  inputText String
  result    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model SiteSetting {
  key   String @id
  value String
}

model KnowledgeChunk {
  id         String   @id @default(cuid())
  subjectId  String?
  scope      String   @default("SHARED") // SHARED | COUPLE
  coupleId   String?
  importId   String?
  sourceType String
  sourceId   String?
  hskLevel   Int?
  content    String
  metadata   String
  embedding  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  couple  Couple?  @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  import  CorpusImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@index([sourceType])
  @@index([hskLevel])
  @@index([sourceId])
  @@index([subjectId, scope, coupleId])
  @@index([importId])
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  coupleId  String?
  subjectId String?
  courseId  String?
  agentType String?
  summary   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  couple    Couple?       @relation(fields: [coupleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([coupleId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  metadata  String?
  createdAt DateTime    @default(now())

  @@index([sessionId])
}

model AiCallLog {
  id        String   @id @default(cuid())
  userId    String?
  endpoint  String
  prompt    String
  response  String?
  latencyMs Int
  tokensIn  Int?
  tokensOut Int?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model CorpusImport {
  id               String   @id @default(cuid())
  coupleId         String
  subjectId        String
  uploadedByUserId String
  originalFilename String
  mimeType         String?
  extension        String?
  parseMode        String?
  preset           String?
  paramVersion     String   @default("chunker.v1")
  status           String   @default("preview") // preview|queued|running|ready|failed|rolled_back|rejected
  totalChunks      Int      @default(0)
  processedChunks  Int      @default(0)
  nextChunkIndex   Int      @default(0)
  embedBatchSize   Int      @default(32)
  lastError        String?
  contentHash      String?
  cancelRequested  Boolean  @default(false)
  heartbeatAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  couple    Couple        @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  subject   Subject       @relation(fields: [subjectId], references: [id])
  uploadedBy User         @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  chunks    ImportChunk[]
  knowledge KnowledgeChunk[]

  @@index([coupleId, status])
  @@index([status, createdAt])
}

model ImportChunk {
  id        String  @id @default(cuid())
  importId  String
  idx       Int
  content   String?
  contentHash String?
  import    CorpusImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, idx])
}

model OutboxEvent {
  id          String    @id @default(cuid())
  eventType   String
  payload     String
  status      String    @default("pending") // pending|sent|failed
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, availableAt])
}
