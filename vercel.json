{
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["hkg1"],
  "crons": [
    {
      "path": "/api/cron/daily-report",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/weekly-report",
      "schedule": "0 16 * * 0"
    }
  ]
}
